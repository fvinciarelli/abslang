{
  "name": "abslang",
  "version": "0.1.9",
  "description": "Agent Behavior Specification — describe, run, and evaluate AI agent interactions from the command line",
  "main": "dist/index.js",
  "bin": {
    "abslang": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc && node dist/cli.js",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ai", "agent", "testing", "evaluation", "specification", "llm", "openapi", "behavior"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fvinciarelli/abslang.git"
  },
  "homepage": "https://fvinciarelli.github.io/abslang",
  "bugs": {
    "url": "https://github.com/fvinciarelli/abslang/issues"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "aievaluator": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
