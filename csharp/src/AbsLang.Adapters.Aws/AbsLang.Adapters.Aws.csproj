<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>AbsLang.Adapters.Aws</AssemblyName>
    <RootNamespace>AbsLang.Adapters.Aws</RootNamespace>
    <PackageId>AbsLang.Adapters.Aws</PackageId>
    <Authors>Franco Vinciarelli</Authors>
    <Description>AWS Bedrock evaluator adapter for AbsLang (Agent Behavior Specification).</Description>
    <PackageTags>abs;ai;agent;evaluation;aws;bedrock</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fvinciarelli/abslang</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <ProjectReference Include="../AbsLang/AbsLang.csproj" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.15" />
  </ItemGroup>

</Project>
